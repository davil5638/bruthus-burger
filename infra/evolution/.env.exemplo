# Copie para .env na VPS e preencha. NAO comite o .env preenchido.

# Endereco publico da VPS. Use http://SEU_IP:8080 para comecar;
# troque por https://seu-dominio quando puser HTTPS na frente.
SERVER_URL=http://SEU_IP:8080

# Voce inventa. E a senha que o sistema manda no header `apikey`.
# Gere algo longo, por exemplo: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do Postgres que sobe junto no compose. Tambem invente.
POSTGRES_PASSWORD=
